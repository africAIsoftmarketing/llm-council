diff --git a/backend/settings.py b/backend/settings.py
new file mode 100644
index 0000000..da6eae8
--- /dev/null
+++ b/backend/settings.py
@@ -0,0 +1,85 @@
+"""Runtime-configurable council settings.
+
+Lets the council models and chairman be changed live from the UI (without
+`heroku config:set`). Defaults come from env vars (see config.py); overrides are
+persisted to a JSON file alongside the conversation data.
+
+NOTE: like conversation storage, this file lives on the ephemeral Heroku
+filesystem and resets on dyno restart. Env vars (COUNCIL_MODELS / CHAIRMAN_MODEL)
+remain the durable defaults.
+"""
+
+import json
+from pathlib import Path
+from typing import List, Optional, Dict, Any
+
+from .config import (
+    COUNCIL_MODELS as DEFAULT_COUNCIL_MODELS,
+    CHAIRMAN_MODEL as DEFAULT_CHAIRMAN_MODEL,
+    DATA_DIR,
+)
+
+SETTINGS_PATH = Path(DATA_DIR).parent / "settings.json"
+
+_state: Dict[str, Any] = {
+    "council_models": list(DEFAULT_COUNCIL_MODELS),
+    "chairman_model": DEFAULT_CHAIRMAN_MODEL,
+}
+
+
+def _load() -> None:
+    if SETTINGS_PATH.exists():
+        try:
+            data = json.loads(SETTINGS_PATH.read_text())
+            if isinstance(data.get("council_models"), list) and data["council_models"]:
+                _state["council_models"] = [m for m in data["council_models"] if m]
+            if data.get("chairman_model"):
+                _state["chairman_model"] = data["chairman_model"]
+        except (json.JSONDecodeError, OSError):
+            pass
+
+
+_load()
+
+
+def get_council_models() -> List[str]:
+    return list(_state["council_models"])
+
+
+def get_chairman_model() -> str:
+    return _state["chairman_model"]
+
+
+def get_settings() -> Dict[str, Any]:
+    return {
+        "council_models": list(_state["council_models"]),
+        "chairman_model": _state["chairman_model"],
+        "defaults": {
+            "council_models": list(DEFAULT_COUNCIL_MODELS),
+            "chairman_model": DEFAULT_CHAIRMAN_MODEL,
+        },
+    }
+
+
+def update_settings(
+    council_models: Optional[List[str]] = None,
+    chairman_model: Optional[str] = None,
+) -> Dict[str, Any]:
+    if council_models is not None:
+        cleaned = [m.strip() for m in council_models if m and m.strip()]
+        if cleaned:
+            _state["council_models"] = cleaned
+    if chairman_model is not None and chairman_model.strip():
+        _state["chairman_model"] = chairman_model.strip()
+
+    SETTINGS_PATH.parent.mkdir(parents=True, exist_ok=True)
+    SETTINGS_PATH.write_text(
+        json.dumps(
+            {
+                "council_models": _state["council_models"],
+                "chairman_model": _state["chairman_model"],
+            },
+            indent=2,
+        )
+    )
+    return get_settings()
