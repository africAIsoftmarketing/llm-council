index 0000000..1c426f0
--- /dev/null
+++ b/frontend/src/components/Settings.jsx
@@ -0,0 +1,247 @@
+import { useState, useEffect } from 'react';
+import { api } from '../api';
+import './Settings.css';
+
+// A few popular OpenRouter model IDs for quick selection. The user can also
+// type any model identifier (e.g. "vendor/model-name") manually.
+const SUGGESTED_MODELS = [
+  'openai/gpt-5.1',
+  'openai/gpt-4.1',
+  'google/gemini-3-pro-preview',
+  'google/gemini-2.5-pro',
+  'google/gemini-2.5-flash',
+  'anthropic/claude-sonnet-4.5',
+  'anthropic/claude-opus-4.1',
+  'x-ai/grok-4',
+  'meta-llama/llama-3.3-70b-instruct',
+  'deepseek/deepseek-chat',
+  'mistralai/mistral-large',
+  'qwen/qwen-2.5-72b-instruct',
+];
+
+export default function Settings({ onClose }) {
+  const [councilModels, setCouncilModels] = useState([]);
+  const [chairmanModel, setChairmanModel] = useState('');
+  const [newModel, setNewModel] = useState('');
+  const [defaults, setDefaults] = useState(null);
+  const [loading, setLoading] = useState(true);
+  const [saving, setSaving] = useState(false);
+  const [error, setError] = useState('');
+  const [saved, setSaved] = useState(false);
+
+  useEffect(() => {
+    (async () => {
+      try {
+        const cfg = await api.getConfig();
+        setCouncilModels(cfg.council_models || []);
+        setChairmanModel(cfg.chairman_model || '');
+        setDefaults(cfg.defaults || null);
+      } catch (e) {
+        setError(e.message);
+      } finally {
+        setLoading(false);
+      }
+    })();
+  }, []);
+
+  const addModel = (model) => {
+    const id = (model || '').trim();
+    if (!id) return;
+    if (councilModels.includes(id)) {
+      setNewModel('');
+      return;
+    }
+    setCouncilModels([...councilModels, id]);
+    setNewModel('');
+    setSaved(false);
+  };
+
+  const removeModel = (model) => {
+    const next = councilModels.filter((m) => m !== model);
+    setCouncilModels(next);
+    if (chairmanModel === model && next.length) {
+      setChairmanModel(next[0]);
+    }
+    setSaved(false);
+  };
+
+  const handleSave = async () => {
+    setError('');
+    if (councilModels.length === 0) {
+      setError('Add at least one council model.');
+      return;
+    }
+    setSaving(true);
+    try {
+      const cfg = await api.updateConfig({
+        council_models: councilModels,
+        chairman_model: chairmanModel,
+      });
+      setCouncilModels(cfg.council_models || []);
+      setChairmanModel(cfg.chairman_model || '');
+      setSaved(true);
+    } catch (e) {
+      setError(e.message);
+    } finally {
+      setSaving(false);
+    }
+  };
+
+  const resetDefaults = () => {
+    if (!defaults) return;
+    setCouncilModels(defaults.council_models || []);
+    setChairmanModel(defaults.chairman_model || '');
+    setSaved(false);
+  };
+
+  const availableSuggestions = SUGGESTED_MODELS.filter(
+    (m) => !councilModels.includes(m)
+  );
+
+  return (
+    <div className="settings-overlay" data-testid="settings-overlay" onClick={onClose}>
+      <div
+        className="settings-modal"
+        data-testid="settings-modal"
+        onClick={(e) => e.stopPropagation()}
+      >
+        <div className="settings-header">
+          <h2>Council Settings</h2>
+          <button
+            className="settings-close"
+            data-testid="settings-close-btn"
+            onClick={onClose}
+            aria-label="Close"
+          >
+            ×
+          </button>
+        </div>
+
+        {loading ? (
+          <div className="settings-loading">Loading…</div>
+        ) : (
+          <div className="settings-body">
+            <p className="settings-hint">
+              Choose which models form the council and who acts as Chairman. Changes
+              apply immediately — no redeploy needed.
+            </p>
+
+            <section className="settings-section">
+              <label className="settings-label">Council members</label>
+              <div className="model-chips" data-testid="council-models-list">
+                {councilModels.length === 0 && (
+                  <span className="empty-hint">No models yet — add one below.</span>
+                )}
+                {councilModels.map((m) => (
+                  <span key={m} className="model-chip" data-testid={`model-chip-${m}`}>
+                    {m}
+                    <button
+                      className="chip-remove"
+                      data-testid={`remove-model-${m}`}
+                      onClick={() => removeModel(m)}
+                      aria-label={`Remove ${m}`}
+                    >
+                      ×
+                    </button>
+                  </span>
+                ))}
+              </div>
+
+              <div className="add-model-row">
+                <input
+                  type="text"
+                  className="add-model-input"
+                  data-testid="add-model-input"
+                  placeholder="Add model ID, e.g. anthropic/claude-sonnet-4.5"
+                  value={newModel}
+                  onChange={(e) => setNewModel(e.target.value)}
+                  onKeyDown={(e) => {
+                    if (e.key === 'Enter') addModel(newModel);
+                  }}
+                />
+                <button
+                  className="add-model-btn"
+                  data-testid="add-model-btn"
+                  onClick={() => addModel(newModel)}
+                >
+                  Add
+                </button>
+              </div>
+
+              {availableSuggestions.length > 0 && (
+                <div className="suggested-models">
+                  <span className="suggested-label">Quick add:</span>
+                  {availableSuggestions.map((m) => (
+                    <button
+                      key={m}
+                      className="suggested-chip"
+                      data-testid={`suggest-${m}`}
+                      onClick={() => addModel(m)}
+                    >
+                      + {m}
+                    </button>
+                  ))}
+                </div>
+              )}
+            </section>
+
+            <section className="settings-section">
+              <label className="settings-label" htmlFor="chairman-select">
+                Chairman (synthesizes the final answer)
+              </label>
+              <select
+                id="chairman-select"
+                className="chairman-select"
+                data-testid="chairman-select"
+                value={chairmanModel}
+                onChange={(e) => {
+                  setChairmanModel(e.target.value);
+                  setSaved(false);
+                }}
+              >
+                {/* allow current chairman even if not in council list */}
+                {!councilModels.includes(chairmanModel) && chairmanModel && (
+                  <option value={chairmanModel}>{chairmanModel}</option>
+                )}
+                {councilModels.map((m) => (
+                  <option key={m} value={m}>
+                    {m}
+                  </option>
+                ))}
+              </select>
+            </section>
+
+            {error && (
+              <div className="settings-error" data-testid="settings-error">
+                {error}
+              </div>
+            )}
+            {saved && (
+              <div className="settings-saved" data-testid="settings-saved">
+                Settings saved ✓
+              </div>
+            )}
+
+            <div className="settings-actions">
+              <button
+                className="settings-reset"
+                data-testid="settings-reset-btn"
+                onClick={resetDefaults}
+              >
+                Reset to defaults
+              </button>
+              <button
+                className="settings-save"
+                data-testid="settings-save-btn"
+                onClick={handleSave}
+                disabled={saving}
+              >
+                {saving ? 'Saving…' : 'Save'}
+              </button>
+            </div>
+          </div>
+        )}
+      </div>
+    </div>
+  );
+}
