# OpenRouter API key — get yours at https://openrouter.ai
# Optional: the app can also be configured at runtime via the in-app Settings UI.
OPENROUTER_API_KEY=sk-or-v1-YOUR_KEY_HERE

# PostgreSQL — set automatically by the Heroku Postgres add-on (DATABASE_URL).
# When present, conversations are stored in Postgres (persistent across restarts).
# When absent, the app falls back to JSON files in DATA_DIR (ephemeral).
# DATABASE_URL=postgres://user:pass@host:5432/dbname
# DB_SSLMODE=require   # 'require' on Heroku; use 'disable' for a local Postgres

# Optional: override JSON storage directory (used only when DATABASE_URL is unset)
# DATA_DIR=data
